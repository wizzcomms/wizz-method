{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "wizz-method",
  "version": "1.4.2",
  "description": "Wizz Method — método de agência orientado por IA em PT-BR (fork independente do BMad Method)",
  "keywords": [
    "agile",
    "ai",
    "orchestrator",
    "development",
    "methodology",
    "agents",
    "wizz",
    "wizzcomms"
  ],
  "homepage": "https://method.wizzcomms.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wizzcomms/wizz-method.git"
  },
  "license": "MIT",
  "author": "Wizz! comms. (wizzcomms)",
  "main": "tools/installer/wizz-cli.js",
  "bin": {
    "wizz": "tools/installer/wizz-cli.js",
    "wizz-method": "tools/installer/wizz-cli.js"
  },
  "files": [
    "tools/installer",
    "src/bmm-skills",
    "src/core-skills",
    "src/modules",
    "src/scripts",
    "src/skills-lib",
    "!src/skills-lib/huashu-design/assets/**/*.mp3",
    "!src/skills-lib/canvas-design/canvas-fonts/**/*.ttf",
    "web-bundles",
    "skills-registry.yaml",
    "wizz-modules.yaml",
    "removals.txt",
    "tools/fetch-assets.mjs"
  ],
  "scripts": {
    "docs:build": "node tools/build-docs.mjs",
    "docs:dev": "astro dev --root website",
    "docs:fix-links": "node tools/fix-doc-links.js",
    "docs:preview": "astro preview --root website",
    "docs:validate-links": "node tools/validate-doc-links.js",
    "docs:validate-sidebar": "node tools/validate-sidebar-order.js",
    "eval:routing": "node evals/routing/run-routing-eval.mjs",
    "eval:routing:llm": "node evals/routing/run-routing-eval.mjs --llm",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,yaml}\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,json,yaml}\"",
    "format:fix:staged": "prettier --write",
    "install:wizz": "node tools/installer/wizz-cli.js install",
    "lint": "eslint . --ext .js,.cjs,.mjs,.yaml --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.cjs,.mjs,.yaml --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || exit 0",
    "quality": "npm run format:check && npm run lint && npm run lint:md && npm run docs:build && npm run test:install && npm run test:urls && npm run validate:refs && npm run validate:method-refs && npm run validate:skills && npm run docs:validate-sidebar",
    "rebundle": "node tools/installer/bundlers/bundle-web.js rebundle",
    "sync:check": "node tools/sync-check.mjs",
    "sync:global": "node tools/sync-global.mjs",
    "test": "npm run test:refs && npm run test:install && npm run test:urls && npm run test:channels && npm run test:mcp && npm run test:env-vars && npm run test:cli && npm run test:deps && npm run test:dispatch-rule && npm run test:hooks && npm run test:quickupdate && npm run test:registry-schema && npm run test:method-refs-allowlist && npm run test:rtk-hook && npm run test:network-retry && npm run test:sync-check && npm run test:resolver && npm run test:fetch-assets && npm run test:install-smoke && npm run test:trace-report && npm run test:rehype-plugins && npm run test:workflow-path-regex && npm run test:preflight-tools-check && npm run lint && npm run lint:md && npm run format:check && npm run sync:check",
    "test:channels": "node test/test-installer-channels.js",
    "test:cli": "node test/test-cli-config.js",
    "test:deps": "node test/test-deps-cache.js",
    "test:dispatch-rule": "node test/test-dispatch-rule-consistency.js",
    "test:env-vars": "node test/test-env-vars.js",
    "test:fetch-assets": "node test/test-fetch-assets.js",
    "test:hooks": "node test/test-router-hook.js",
    "test:install": "node test/test-installation-components.js",
    "test:install-smoke": "node test/test-install-smoke.js",
    "test:install-smoke-mcp": "node test/test-install-smoke-mcp.js",
    "test:mcp": "node test/test-mcp-config.js",
    "test:method-refs-allowlist": "node test/test-method-refs-allowlist.js",
    "test:network-retry": "node test/test-network-retry.js",
    "test:preflight-tools-check": "node test/test-preflight-tools-check.js",
    "test:quickupdate": "node test/test-quick-update-gate.js",
    "test:refs": "node test/test-file-refs-csv.js",
    "test:registry-schema": "node test/test-registry-schema.js",
    "test:rehype-plugins": "node test/test-rehype-plugins.mjs",
    "test:resolver": "node test/test-resolve-customization.js",
    "test:rtk-hook": "node test/test-rtk-hook.js",
    "test:sync-check": "node test/test-sync-check.js",
    "test:trace-report": "node test/test-trace-report.js",
    "test:urls": "node test/test-parse-source-urls.js",
    "test:workflow-path-regex": "node test/test-workflow-path-regex.js",
    "validate:method-refs": "node tools/validate-method-refs.js --strict",
    "validate:refs": "node tools/validate-file-refs.js --strict",
    "validate:registry-schema": "node tools/validate-registry-schema.js --strict",
    "validate:skills": "node tools/validate-skills.js --strict",
    "wizz:install": "node tools/installer/wizz-cli.js install",
    "wizz:uninstall": "node tools/installer/wizz-cli.js uninstall"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "npm run lint:fix",
      "npm run format:fix:staged"
    ],
    "*.yaml": [
      "eslint --fix",
      "npm run format:fix:staged"
    ],
    "*.json": [
      "npm run format:fix:staged"
    ],
    "*.md": [
      "markdownlint-cli2"
    ]
  },
  "overrides": {
    "markdownlint-cli2": {
      "js-yaml": "^4.3.0",
      "markdown-it": "^14.2.0"
    }
  },
  "dependencies": {
    "@clack/core": "^1.3.1",
    "@clack/prompts": "^1.4.0",
    "@kayvan/markdown-tree-parser": "^1.6.1",
    "chalk": "^4.1.2",
    "commander": "^14.0.0",
    "csv-parse": "^6.1.0",
    "glob": "^13.0.6",
    "ignore": "^7.0.5",
    "js-yaml": "^4.3.0",
    "picocolors": "^1.1.1",
    "semver": "^7.6.3",
    "xml2js": "^0.6.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/starlight": "^0.37.5",
    "@eslint/js": "^9.33.0",
    "astro": "^5.16.0",
    "c8": "^10.1.3",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-yml": "^1.18.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.1.1",
    "markdownlint-cli2": "^0.19.1",
    "prettier": "^3.7.4",
    "prettier-plugin-packagejson": "^2.5.19",
    "sharp": "^0.33.5",
    "unist-util-visit": "^5.1.0",
    "yaml-eslint-parser": "^1.2.3",
    "yaml-lint": "^1.7.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
